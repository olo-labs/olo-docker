# Optional overrides for docker-compose-olo.yml (copy to .env in this folder).

# Host path mounted into the olo container at /app/olo-configuration.
# OLO_CONFIGURATION_SOURCE=../../olo-labs/olo/olo-configuration

# Extension catalog for olo-ui studio (catalog.json from olo-core dist).
# OLO_CATALOG_SOURCE=../../olo-labs/olo-mono/olo-core/dist/catalog

# Callback URL embedded in workflow input for host-run workers (gradlew/IDE).
# OLO_CHAT_CALLBACK_BASE_URL=http://localhost:47080
